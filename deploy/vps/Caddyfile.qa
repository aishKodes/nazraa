# Obtain and validate real TLS on the two new names without exposing the
# writable staging copy of production data to arbitrary Internet clients.
# Replace this with Caddyfile only after the final one-writer cutover gates.
api.nazraa.pixtra.site {
    @qa remote_ip {$QA_CLIENT_CIDR}
    handle @qa {
        @private path /api/internal/*
        handle @private {
            respond "Not found" 404
        }
        reverse_proxy nazraa-api-candidate:3000
    }
    handle {
        respond "Not found" 404
    }
}

ws.nazraa.pixtra.site {
    @qa remote_ip {$QA_CLIENT_CIDR}
    handle @qa {
        reverse_proxy nazraa-realtime-staging:3100
    }
    handle {
        respond "Not found" 404
    }
}
