api.nazraa.pixtra.site {
    encode zstd gzip
    # LiveKit must be able to deliver signed publish/disconnect evidence after
    # cutover. The route itself verifies the provider's JWT/body signature;
    # all other internal API paths remain hidden from the public Internet.
    @livekit_webhook path /api/internal/livekit/webhook
    handle @livekit_webhook {
        reverse_proxy api:3000
    }
    @private path /api/internal/*
    handle @private {
        respond "Not found" 404
    }
    handle {
        reverse_proxy api:3000
    }
}

ws.nazraa.pixtra.site {
    encode zstd gzip
    reverse_proxy realtime:3100
}

# The public marketing/download site remains on its existing Vercel hostname.
# Add a dedicated frontend hostname only after its DNS and TLS are verified.
