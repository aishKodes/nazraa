# Leave unset until Hostinger MySQL is ready. These values are used only by server code.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-characters
# Temporary first-login values. Remove all three from Vercel after the first Master login.
INITIAL_MASTER_NAME=
INITIAL_MASTER_CODE=
INITIAL_MASTER_PASSWORD=
# Only used by npm run bootstrap:master; do not leave it set in a deployed environment.
MASTER_PASSWORD=
